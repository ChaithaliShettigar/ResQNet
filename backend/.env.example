# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resqnet?retryWrites=true&w=majority

# JWT Authentication Secret & Expiration
JWT_SECRET=resqnet_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# Gnani AI API Credentials (Vachana Platform)
# Pass your API key from the Gnani AI developer console
GNANI_API_KEY=your_gnani_api_key_here
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0

# OpenRouter API (used for LLM incident analysis and multilingual translation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=your_openrouter_model_id

# Optional local OpenAI-compatible Evon server (reserved for future use)
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_BASE_URL=http://localhost:8000/v1

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173

